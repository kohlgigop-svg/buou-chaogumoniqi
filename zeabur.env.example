# 大布偶证券交易所 —— Zeabur 部署环境变量模板
#
# 用法：复制为 Zeabur 服务的 Variables（或本机 .env 后逐行粘贴），把 replace-* 换成真实值。
# 参考：docs/superpowers/specs/2026-08-28-paper-trader-design.md §17
#      docs/superpowers/plans/2026-09-11-plan-c-acceptance.md §5

# ============ 必填 ============

# 全局随机种子：相同种子 + 相同库状态 ⇒ 完全可重放。
# 生产请用一次性生成的长随机串（如 `openssl rand -hex 32`）。
# ⚠️ 一旦上线【不要再改】——改动会使行情/事件序列与已有库状态错位。
MASTER_SEED=replace-with-a-long-random-string

# 创世时刻（ISO 8601 或毫秒）。决定游戏日推进与所有时间窗。
# 建议固定为首次上线时刻；⚠️ 上线后不要随意变动。
GENESIS_TS=2026-01-01T00:00:00.000Z

# 管理员账号：服务启动时 upsert。密码务必用强口令。
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ============ 持久化（必须与持久卷挂载点一致）============
# Zeabur → 服务 → Volumes：新建持久卷，挂载路径填 /data
DATABASE_PATH=/data/game.db
DATA_DIR=/data

# ============ 服务 ============
PORT=8080
NODE_ENV=production

# ============ 可选 ============
# 前端产物目录。默认 ./web/dist（镜像内已随构建产出）。
# 设为空串可强制只跑 API（例如前后端分离部署时）。
# WEB_DIST=./web/dist
